{
  "name": "graph-warden",
  "private": true,
  "description": "A governed knowledge graph for AI agents: scoped access, provenance, erasure and audit.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks",
    "db:up": "docker compose up -d --wait neo4j",
    "db:down": "docker compose down",
    "gwarden": "node --env-file-if-exists=.env packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\" && { grep -q '^Signed-off-by: ' \"$1\" || { echo 'Missing Signed-off-by: commit with git commit -s (see CONTRIBUTING.md#sign-your-commits)'; exit 1; }; }"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --max-warnings=0"
  }
}
