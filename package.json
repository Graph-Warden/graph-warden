{
  "name": "graph-warden",
  "private": true,
  "description": "A governed knowledge graph for AI agents: scoped access, provenance, erasure and audit.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\" && { grep -q '^Signed-off-by: ' \"$1\" || { echo 'Missing Signed-off-by: commit with git commit -s (see CONTRIBUTING.md#sign-your-commits)'; exit 1; }; }"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --max-warnings=0"
  }
}
