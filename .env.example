# Copy to `.env`. Read by docker compose and by the gwarden CLI (node --env-file=.env).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graph-warden

# For readers: the API and a token from its identity provider (gwarden traverse, pull, cache, audit).
# GWARDEN_API=http://localhost:8080
# GWARDEN_TOKEN=

# For the API: who may delete and file answers, and the model behind /v1/ask (none or claude, with
# ANTHROPIC_API_KEY or an `ant auth login` profile).
# GWARDEN_WRITERS=dev-leads
# GWARDEN_LLM=claude
# GWARDEN_LLM_MODEL=claude-opus-5-5

# For the web app (proposal 0012): a session secret of at least 32 characters turns it on, served by
# the API at GWARDEN_PUBLIC_URL. With an OIDC or Google identity, browsers sign in through an OAuth
# client whose secret the API holds.
# GWARDEN_WEB_SECRET=
# GWARDEN_PUBLIC_URL=http://localhost:8080
# GWARDEN_WEB_DIR=packages/web/dist
# WEB_OIDC_CLIENT_ID=
# WEB_OIDC_CLIENT_SECRET=
