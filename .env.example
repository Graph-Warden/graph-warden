# Copy to `.env`. Read by docker compose and by the gwarden CLI (node --env-file=.env).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graph-warden

# For readers: the API and a token from its identity provider (gwarden traverse, pull, cache, audit).
# GWARDEN_API=http://localhost:8080
# GWARDEN_TOKEN=

# For the API: who may delete and file answers, and the model behind /v1/ask (none, claude or openai).
# Claude runs on one of three platforms: anthropic (ANTHROPIC_API_KEY or an `ant auth login`
# profile), vertex or google-cloud (Google credentials, no API key: the service account on Cloud
# Run, `gcloud auth application-default login` locally).
# GWARDEN_WRITERS=dev-leads
# GWARDEN_LLM=claude
# GWARDEN_LLM_PLATFORM=anthropic
# GWARDEN_LLM_MODEL=claude-opus-5-5
# CLOUD_ML_REGION=global                       # vertex
# ANTHROPIC_GOOGLE_CLOUD_WORKSPACE_ID=wrkspc_  # google-cloud
# Or any OpenAI-compatible API: a model name is required, the base URL defaults to OpenAI.
# GWARDEN_LLM=openai
# GWARDEN_LLM_MODEL=llama3.3
# GWARDEN_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; vLLM and LM Studio alike
# OPENAI_API_KEY=                                  # OpenAI, Azure OpenAI, Mistral
# Model routing by sensitivity (issue #28): content of a confidential source goes only to the
# local model, an OpenAI-compatible server run alongside (Ollama by default); without one it is
# refused. The policy file lists sources: default: internal, confidential: [docs:hr, "github:acme/payroll*"].
# GWARDEN_LOCAL_LLM_MODEL=qwen3-coder:30b
# GWARDEN_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# GWARDEN_SENSITIVITY=./sensitivity.yaml

# The organisation's node and edge types, added to the core ones (proposal 0001), read by the API and
# by `gwarden ingest`: a YAML file with `nodeTypes: [...]` and `edgeTypes: [...]`.
# GWARDEN_ONTOLOGY=examples/shop/ontology.yaml

# For the web app (proposal 0012): a session secret of at least 32 characters turns it on, served by
# the API at GWARDEN_PUBLIC_URL. With an OIDC or Google identity, browsers sign in through an OAuth
# client whose secret the API holds.
# GWARDEN_WEB_SECRET=
# GWARDEN_PUBLIC_URL=http://localhost:8080
# GWARDEN_WEB_DIR=packages/web/dist
# WEB_OIDC_CLIENT_ID=
# WEB_OIDC_CLIENT_SECRET=
