  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@graph-warden/core": "workspace:*",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@graph-warden/git": "workspace:*",
    "@graph-warden/memory": "workspace:*"
  }
}
