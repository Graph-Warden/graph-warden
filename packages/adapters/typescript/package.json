{
  "name": "@graph-warden/typescript",
  "version": "0.0.0",
  "description": "Extractor for Graph-Warden: Module nodes and IMPORTS edges resolved by the TypeScript compiler.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
