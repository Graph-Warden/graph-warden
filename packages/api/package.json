{
  "name": "@graph-warden/api",
  "version": "0.0.0",
  "description": "The Graph-Warden API: the one place readers reach the graph, with their scopes and an audit entry on every read.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/static": "catalog:",
    "@graph-warden/anthropic": "workspace:*",
    "@graph-warden/core": "workspace:*",
    "@graph-warden/documents": "workspace:*",
    "@graph-warden/identity": "workspace:*",
    "@graph-warden/neo4j": "workspace:*",
    "@graph-warden/openai": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "neo4j-driver": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graph-warden/memory": "workspace:*"
  }
}
