{
  "name": "@graph-warden/api",
  "version": "0.0.0",
  "description": "The Graph-Warden API: the one place readers reach the graph, with their scopes and an audit entry on every read.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@graph-warden/anthropic": "workspace:*",
    "@graph-warden/core": "workspace:*",
    "@graph-warden/identity": "workspace:*",
    "@graph-warden/neo4j": "workspace:*",
    "@graph-warden/openai": "workspace:*",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "neo4j-driver": "^6.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graph-warden/memory": "workspace:*"
  }
}
