{
  "name": "@graph-warden/worker",
  "version": "0.0.0",
  "description": "The Graph-Warden ingestion worker: learns about merges by webhook, by push from CI or by polling, and ingests them in git order.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gwarden-worker": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@graph-warden/anthropic": "workspace:*",
    "@graph-warden/confluence": "workspace:*",
    "@graph-warden/core": "workspace:*",
    "@graph-warden/documents": "workspace:*",
    "@graph-warden/git": "workspace:*",
    "@graph-warden/gitlab": "workspace:*",
    "@graph-warden/jira": "workspace:*",
    "@graph-warden/memory": "workspace:*",
    "@graph-warden/neo4j": "workspace:*",
    "@graph-warden/openai": "workspace:*",
    "@graph-warden/openapi": "workspace:*",
    "@graph-warden/redis": "workspace:*",
    "@graph-warden/typescript": "workspace:*",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "neo4j-driver": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
