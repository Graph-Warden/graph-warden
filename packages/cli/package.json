{
  "name": "@graph-warden/cli",
  "version": "0.0.0",
  "description": "gwarden: ingest sources into a Graph-Warden graph and query it as a given principal.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "gwarden": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@graph-warden/anthropic": "workspace:*",
    "@graph-warden/core": "workspace:*",
    "@graph-warden/documents": "workspace:*",
    "@graph-warden/git": "workspace:*",
    "@graph-warden/memory": "workspace:*",
    "@graph-warden/neo4j": "workspace:*",
    "@graph-warden/openai": "workspace:*",
    "@graph-warden/openapi": "workspace:*",
    "@graph-warden/typescript": "workspace:*",
    "neo4j-driver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/jsonld": "catalog:",
    "fast-xml-parser": "catalog:",
    "jsonld": "catalog:"
  }
}
